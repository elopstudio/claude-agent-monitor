{
  "name": "agent-monitor-desktop",
  "productName": "Agent Monitor",
  "version": "0.2.1",
  "private": true,
  "description": "Agent Monitor as a desktop app: the monitor server in its own window and the tray",
  "license": "MIT",
  "author": "elopstudio",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "studio.elop.agent-monitor",
    "productName": "Agent Monitor",
    "files": [
      "main.cjs",
      "preload.cjs",
      "strip.html",
      "settings.html",
      "settings-preload.cjs",
      "hooks-setup.cjs",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "monitor",
        "filter": [
          "server.mjs",
          "agents.mjs",
          "account.mjs",
          "tokens.mjs",
          "package.json",
          "LICENSE",
          "public/**/*",
          "hooks/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Agent Monitor"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elopstudio",
        "repo": "claude-agent-monitor",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
